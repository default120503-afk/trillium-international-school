# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Production
build/
dist/

# Environment — never commit real values.
# `.env*` catches .env, .env.local, .env.development, .env.production and any
# other per-environment variant; the negation re-admits the committed template.
.env*
!.env.example

# Vercel
.vercel/
.vercel-inspect/

# Certificates, keys and credential stores — never commit these
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
credentials.json
service-account*.json
secrets.json

# The founder photograph, deliberately removed from the site.
# Nothing in src/ references it any more, but `public/` is copied verbatim into
# the deployed bundle, so without this it would still be published at the
# guessable path /images/founder/farzana-tabussum.jpg. Excluding it from the
# repository is what actually keeps it off the live site; the files stay on
# disk, untouched and recoverable.
public/images/founder/
Farzana_Tabussum.jpeg

# Large build-irrelevant source material
# The scanned 8-page school brochure (~17 MB) is the original the gallery was
# derived from. It is documentation, not a build input, and it has no reason to
# live in a public repository. It stays on disk, untouched.
CamScanner *.pdf

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Verification scratch: screenshots, sweep logs, ad-hoc test scripts.
# Contains large PNG captures and is not part of the deliverable.
.work/