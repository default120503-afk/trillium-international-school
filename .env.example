# ---------------------------------------------------------------------------
# TISS website - example environment configuration.
# Copy to `.env.local` and fill in real values. NEVER commit a real .env file.
# Every value here is a SAFE PLACEHOLDER; unconfigured fields stay hidden from
# the public site rather than showing invented contact details.
# ---------------------------------------------------------------------------

# The school's official domain. Leave empty in development: when unset the
# site omits canonical URLs, sitemap host and absolute Open Graph URLs rather
# than inventing a domain. Required before production deployment.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Admissions inquiry delivery
# ---------------------------------------------------------------------------
# The admissions form posts to this path. With no delivery channel configured
# the server returns 503 and the UI shows an honest "not yet delivered" error
# plus the alternative contact route. It never shows a fake success message.
# NEXT_PUBLIC_ prefix is required: the client form needs to know the path.
NEXT_PUBLIC_ADMISSIONS_ENDPOINT_PATH=/api/admissions

# Set to "1" ONLY after a real delivery channel is wired up server-side
# (see src/lib/admissions/delivery.ts and README "Admissions delivery").
# While unset the form validates, then reports that delivery is not configured.
ADMISSIONS_DELIVERY_ENABLED=

# Where verified admissions inquiries are forwarded.
# Required when ADMISSIONS_DELIVERY_ENABLED=1. Keep server-side only.
ADMISSIONS_NOTIFICATION_EMAIL=